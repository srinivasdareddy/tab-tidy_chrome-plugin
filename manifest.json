{
  "manifest_version": 3,
  "name": "Tab Tidy — Close Duplicate Tabs",
  "version": "1.3.0",
  "description": "Find tabs by domain and page title, clear duplicates, prevent new duplicates with Shield, and park inactive tabs. Includes Undo.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tab Tidy — Find and close duplicate tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
